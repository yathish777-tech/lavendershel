{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:banner": "node scripts/banner.js",
    "dev:storefront": "vite frontend --port=5713 --host=0.0.0.0",
    "dev:admin": "vite admin-app --port=5714 --host=0.0.0.0",
    "dev:backend": "python3 -m uvicorn app.main:app --app-dir backend --port=8000 --reload || echo 'FastAPI backend can be started with: uvicorn app.main:app --app-dir backend --port 8000 --reload'",
    "dev:preview": "vite --port=3000 --host=0.0.0.0",
    "dev": "node scripts/banner.js && concurrently -c \"magenta.bold,blue.bold,green.bold,yellow.bold\" -n \"STOREFRONT,ADMIN,API,PREVIEW\" \"npm:dev:storefront\" \"npm:dev:admin\" \"npm:dev:backend\" \"npm:dev:preview\"",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^10.0.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^13.4.6",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
